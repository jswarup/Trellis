<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

  <Type Name="trellis::rube::layout::Layout">
    <DisplayString>Layout modules={_Modules._Sz.v} hierarchyCompiled={_HierarchyCompiled}</DisplayString>
    <Expand>
      <Item Name="Modules">_Modules</Item>
      <Item Name="Ports">_Ports</Item>
      <Item Name="Construction children">_ModuleChildren</Item>
      <Item Name="Compiled children">_SubModules</Item>
      <Item Name="Hierarchy preorder">_Descendents</Item>
      <Item Name="Port triggers">_PortToTrigger</Item>
    </Expand>
  </Type>

  <Type Name="trellis::silo::buff::Buff&lt;*&gt;">
    <DisplayString>Buff cap={_Cap}</DisplayString>
    <Expand>
      <ArrayItems>
        <Size>_Cap</Size>
        <ValuePointer>_Ptr</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="trellis::silo::arr::Arr&lt;*&gt;">
    <DisplayString>Arr size={_Size}</DisplayString>
    <Expand>
      <ArrayItems>
        <Size>_Size</Size>
        <ValuePointer>_Ptr</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="trellis::silo::arr::MutArr&lt;*&gt;">
    <DisplayString>MutArr size={_Size}</DisplayString>
    <Expand>
      <ArrayItems>
        <Size>_Size</Size>
        <ValuePointer>_Ptr</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="trellis::silo::stash::Stash&lt;*&gt;">
    <DisplayString>Stash size={_Sz.v} cap={_Buff._Cap}</DisplayString>
    <Expand>
      <ArrayItems>
        <Size>_Sz.v</Size>
        <ValuePointer>_Buff._Ptr</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="trellis::silo::stk::Stk&lt;*&gt;">
    <DisplayString>Stk cap={_Arr._Size}</DisplayString>
    <Expand>
      <ArrayItems>
        <Size>_Arr._Size</Size>
        <ValuePointer>_Arr._Ptr</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="trellis::silo::seg::Seg">
    <DisplayString Condition="_First &gt; _Last">Seg empty</DisplayString>
    <DisplayString>Seg [{_First}, {_Last}] len={_Last - _First + 1}</DisplayString>
  </Type>

  <Type Name="trellis::silo::dset::DisjointSet">
    <DisplayString>DisjointSet size={_Parent._Sz.v}</DisplayString>
  </Type>

  <Type Name="trellis::silo::fifo::Fifo&lt;*,*&gt;">
    <DisplayString>Fifo size={_Size} cap={$T2}</DisplayString>
  </Type>

  <Type Name="trellis::cove::context::TestCase">
    <DisplayString>{suite,s8}::{name,s8}</DisplayString>
  </Type>

  <Type Name="trellis::swarm::traits::WorkgroupDim">
    <DisplayString>[{_X}, {_Y}, {_Z}]</DisplayString>
  </Type>

  <Type Name="trellis::swarm::traits::BufferUsage">
    <DisplayString>BufferUsage 0x{_Bits,x}</DisplayString>
  </Type>

  <Type Name="trellis::rube::vcd_model::VcdSignal">
    <DisplayString>VCD signal bits={_Bits} changes={_Changes._Cap}</DisplayString>
    <Expand>
      <Item Name="Name">_FullName</Item>
      <Item Name="Identifier">_Id</Item>
      <Item Name="Type">_Type</Item>
      <Item Name="Changes">_Changes</Item>
    </Expand>
  </Type>

  <Type Name="trellis::rube::vcd_model::VcdDisplayModel">
    <DisplayString>VCD signals={_Signals._Cap} time=[{_TimeMin}, {_TimeMax}]</DisplayString>
    <Expand>
      <Item Name="Timescale">_Timescale</Item>
      <Item Name="Signals">_Signals</Item>
      <Item Name="Scopes">_Scopes</Item>
    </Expand>
  </Type>

  <Type Name="trellis::symph::vertshade::CameraUniforms">
    <DisplayString>Camera {_Width} x {_Height} zoom={_Zoom} distance={_Distance}</DisplayString>
  </Type>

  <Type Name="trellis::symph::vertshade::CameraProjection">
    <DisplayString>Prepared camera {_Camera._Width} x {_Camera._Height}</DisplayString>
    <Expand>
      <Item Name="Camera">_Camera</Item>
      <Item Name="Sin X">_SinX</Item>
      <Item Name="Cos X">_CosX</Item>
      <Item Name="Sin Y">_SinY</Item>
      <Item Name="Cos Y">_CosY</Item>
    </Expand>
  </Type>

  <Type Name="trellis::karst::host_node::KarstHostNode">
    <DisplayString>Host {_host_id} link0 valid={_L0TxValid} link1 valid={_L1TxValid}</DisplayString>
    <Expand>
      <Item Name="Statistics">_stats</Item>
      <Item Name="Active requests">_active_queue</Item>
      <Item Name="Queued requests">_tx_queue</Item>
      <Item Name="Responses">_rx_queue</Item>
      <Item Name="Link 0 data">_L0TxData</Item>
      <Item Name="Link 0 ready">_L0RxReady</Item>
      <Item Name="Link 1 data">_L1TxData</Item>
      <Item Name="Link 1 ready">_L1RxReady</Item>
    </Expand>
  </Type>

  <Type Name="trellis::karst::noc::KarstNoc">
    <DisplayString>NoC die={_die_id}</DisplayString>
    <Expand>
      <Item Name="Link RX ready">_KlRxReady</Item>
      <Item Name="Link TX valid">_KlTxValid</Item>
      <Item Name="Link TX data">_KlTxData</Item>
      <Item Name="Memory request valid">_McReqValid</Item>
      <Item Name="Memory request data">_McReqData</Item>
      <Item Name="Memory response ready">_McRespReady</Item>
    </Expand>
  </Type>

  <Type Name="trellis::symph::vertshade::Vec3">
    <DisplayString>({x}, {y}, {z})</DisplayString>
  </Type>

  <Type Name="trellis::symph::vertshade::Vec4">
    <DisplayString>({x}, {y}, {z}, {w})</DisplayString>
  </Type>

  <Type Name="trellis::crew::protocol::ProtocolMessage">
    <DisplayString>ProtocolMessage act={_ActionId} addr=0x{_Addr,x} val=0x{_Value,x}</DisplayString>
  </Type>

  <Type Name="trellis::karst::link::KarstFlit">
    <DisplayString>KarstFlit w={_IsWrite} src={_SrcId} addr=0x{_Addr,x} data=0x{_Data,x}</DisplayString>
  </Type>

  <Type Name="trellis::karst::host_node::HostResponse">
    <DisplayString>HostResponse addr=0x{_Addr,x} data=0x{_Data,x} fault={_Fault}</DisplayString>
  </Type>

  <Type Name="trellis::karst::memchan::MemChan">
    <DisplayString>MemChan chan={_chan_idx} cap={_capacity}</DisplayString>
  </Type>

  <Type Name="trellis::karst::vpu::Vpu">
    <DisplayString>Vpu idx={_vpu_idx} dispatches={_dispatches}</DisplayString>
  </Type>

  <Type Name="trellis::fenst::cask_scene::CaskScene">
    <DisplayString>Cask scene nodes={_Nodes._Cap}</DisplayString>
    <Expand><Item Name="Nodes">_Nodes</Item></Expand>
  </Type>
  <Type Name="trellis::fenst::cask_scene::CaskVolume">
    <DisplayString>Cask depth={_Depth} height={_Height} size={_Size}</DisplayString>
    <Expand>
      <Item Name="Name">_Name</Item>
      <Item Name="Parent">_Parent</Item>
      <Item Name="Children">_Children</Item>
      <Item Name="Height">_Height</Item>
      <Item Name="Origin">_Origin</Item>
      <Item Name="Size">_Size</Item>
    </Expand>
  </Type>
  <Type Name="trellis::fleck::geometry::GeometryAsset">
    <DisplayString>Geometry vertices={_Vertices._Cap} levels={_Levels._Cap}</DisplayString>
    <Expand>
      <Item Name="Vertices">_Vertices</Item>
      <Item Name="Triangles">_Triangles</Item>
      <Item Name="Depth ranges">_Levels</Item>
      <Item Name="Labels">_Labels</Item>
      <Item Name="Point samples">_Samples</Item>
      <Item Name="Source bounds">_Bounds</Item>
    </Expand>
  </Type>
  <Type Name="trellis::fleck::geometry::GeometrySamples">
    <DisplayString>Point samples={_Vertices._Cap} levels={_Levels._Cap}</DisplayString>
    <Expand>
      <Item Name="Vertices">_Vertices</Item>
      <Item Name="Depth ranges">_Levels</Item>
    </Expand>
  </Type>
</AutoVisualizer>
