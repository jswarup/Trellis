{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cargo-build",
            "type": "shell",
            "command": "cargo",
            "args": ["build"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cargo-check",
            "type": "shell",
            "command": "cargo",
            "args": ["check"],
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cargo-clippy",
            "type": "shell",
            "command": "cargo",
            "args": ["clippy", "--", "-D", "warnings"],
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cargo-test",
            "type": "shell",
            "command": "cargo",
            "args": ["test"],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cove-run-tests (-test)",
            "type": "shell",
            "command": "cargo",
            "args": ["run", "--", "-test"],
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cove-run-console (-c)",
            "type": "shell",
            "command": "cargo",
            "args": ["run", "--", "-c"],
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cove-run-examples (-e)",
            "type": "shell",
            "command": "cargo",
            "args": ["run", "--", "-e"],
            "problemMatcher": ["$rustc"]
        }
    ]
}
