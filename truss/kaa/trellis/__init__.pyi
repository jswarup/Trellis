    status: str
    converged: bool
    message: Optional[str]
    best_x: List[float]
    raw_residuals: List[float]
    scaled_residuals: List[float]
    objective: float
    gradient_norm_inf: float
    final_lambda: float
    accepted_iterations: int
    trial_attempts: int
    rejected_trials: int
    residual_evals: int
    jacobian_evals: int
    damping_retries: int

    def best_x_numpy(self) -> Any:
        """Returns a newly allocated 1D NumPy float64 ndarray copy of best_x."""
        ...

    def __repr__(self) -> str: ...
    def __str__(self) -> str: ...

