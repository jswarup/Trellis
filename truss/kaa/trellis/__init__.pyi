class Tensor:
    """Symbolic tensor expression scoped to a FrescoContext."""

    @property
    def context_id(self) -> int: ...
    @property
    def shape(self) -> Tuple[int, ...]: ...
    @property
    def rank(self) -> int: ...
    @property
    def total_elements(self) -> int: ...

    def elem(self, indices: Sequence[int]) -> int: ...
    def subtensor(self, i: int) -> Tensor: ...
    def row(self, r: int) -> Tensor: ...
    def col(self, c: int) -> Tensor: ...
    def transpose(self) -> Tensor: ...
    def reshape(self, shape: Sequence[int]) -> Tensor: ...
    def flatten(self) -> Tensor: ...
    def dot(self, other: Tensor) -> int: ...
    def outer(self, other: Tensor) -> Tensor: ...
    def scale(self, scalar: float) -> Tensor: ...
    def __add__(self, other: Tensor) -> Tensor: ...
    def __sub__(self, other: Tensor) -> Tensor: ...
    def __mul__(self, other: Tensor) -> Tensor: ...
    def __truediv__(self, other: Tensor) -> Tensor: ...
    def __matmul__(self, other: Tensor) -> Tensor: ...

    def evaluate(self, bindings: Optional[Dict[str, float]] = None) -> List[float]: ...
    def to_numpy(self, bindings: Optional[Dict[str, float]] = None) -> Any:
        """Evaluates the tensor and returns a newly allocated NumPy float64 ndarray copy."""
        ...

    def __repr__(self) -> str: ...
    def __str__(self) -> str: ...

class LeastSquaresDiagnostics:
