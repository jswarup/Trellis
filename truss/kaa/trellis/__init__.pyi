    @property
    def variable_count(self) -> int: ...

    def evaluate_residuals(self, x: Sequence[float]) -> Tuple[float, List[float], List[float]]: ...
    def evaluate_jacobian(self, x: Sequence[float]) -> List[List[float]]: ...
    def solve(self, initial_x: Sequence[float]) -> LeastSquaresDiagnostics: ...

    def __repr__(self) -> str: ...
    def __str__(self) -> str: ...

class FrescoContext:
    """Scoped Fresco symbolic repository owning expressions, variables, tensors, and solvers."""

    def __init__(self) -> None: ...

    @property
    def id(self) -> int: ...
    @property
    def expr_count(self) -> int: ...
    @property
    def var_count(self) -> int: ...

    def var(self, name: str, reuse: bool = True) -> int: ...
    def real(self, value: float) -> int: ...
    def parse(self, text: str) -> int: ...
    def differentiate(self, expr_id: int, var_name: str) -> int: ...
    def evaluate(self, expr_id: int, bindings: Optional[Dict[str, float]] = None) -> float: ...
    def vector_var(self, name: str, length: int) -> Tensor: ...
    def matrix_var(self, name: str, rows: int, cols: int) -> Tensor: ...
    def tensor_zeros(self, shape: Sequence[int]) -> Tensor: ...
    def tensor_from_list(self, shape: Sequence[int], values: Sequence[float]) -> Tensor: ...
    def tensor_from_numpy(self, array: Any) -> Tensor:
        """Copies elements from a NumPy array (float64) into owned FrescoContext constant nodes."""
        ...

    def prepare_least_squares(
        self,
        residuals: Sequence[int],
        active_vars: Sequence[str],
        *,
        fixed_bindings: Optional[Dict[str, float]] = None,
        var_scales: Optional[Sequence[float]] = None,
        residual_scales: Optional[Sequence[float]] = None,
        backend: str = "symbolic",
        max_iterations: int = 100,
        residual_tolerance: float = 1e-10,
        gradient_tolerance: float = 1e-10,
    ) -> LeastSquaresSolver: ...

    def __repr__(self) -> str: ...
    def __str__(self) -> str: ...
