# Generated by Cargo
**/target/
/out/
**/*.rs.bk
# Keep the root workspace lockfile reproducible; nested application/tool locks
# remain generated unless they are explicitly part of a package boundary.
**/Cargo.lock
!/Cargo.lock

# MSVC & Visual Studio
.vs/
*.user
*.suo
*.pdb
*.ilk

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# OS files
.DS_Store
Thumbs.db

# Python & Jupyter
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.ipynb_checkpoints/
